# Set these before production deployment. Comma-separate every allowed host.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-server.example.com
# Keep True for local runserver when DEBUG=False; set False when production serves /static/ itself.
DJANGO_SERVE_STATIC_FILES=True
# Optional Gmail sender for published CHO resident alerts. Use a Google App Password,
# never your regular Gmail password. Leave blank to print emails to the Django console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_BASE_URL=http://127.0.0.1:8000
# This opens the installed mobile app; production App Links need a verified HTTPS domain.
MOBILE_ALERT_LINK_BASE=denguewatch://alert
MOBILE_NOTIFICATIONS_LINK=denguewatch://alerts
MOBILE_VERIFICATION_LINK_BASE=denguewatch://verify-email
